# ╔══════════════════════════════════════════════════════════════╗
# ║  VOID — CAVA Audio Visualizer Configuration                  ║
# ║  ~/.config/cava/config                                        ║
# ╚══════════════════════════════════════════════════════════════╝

[general]
framerate = 60
autosens = 1
overshoot = 20
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0
bar_delimiter = 0

[color]
background = '000000'
foreground = 'cccccc'

gradient = 1
gradient_count = 4
gradient_color_1 = '#2a2a2a'
gradient_color_2 = '#555555'
gradient_color_3 = '#888888'
gradient_color_4 = '#cccccc'

[smoothing]
integral = 77
monstercat = 0
waves = 0
gravity = 100
ignore = 0
noise_reduction = 0.77

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
