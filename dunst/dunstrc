# ╔══════════════════════════════════════════════════════════════╗
# ║  VOID — Dunst Notification Configuration                     ║
# ║  ~/.config/dunst/dunstrc                                      ║
# ╚══════════════════════════════════════════════════════════════╝

[global]
    # --- DISPLAY ---
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 180)
    origin = top-right
    offset = (14, 42)
    notification_limit = 5

    # --- APPEARANCE ---
    transparency = 18
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14
    frame_width = 1
    frame_color = "#1a1a1a"
    gap_size = 6
    separator_height = 1
    separator_color = frame
    corner_radius = 5
    icon_corner_radius = 0
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    # --- TEXT ---
    font = JetBrains Mono Nerd Font 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    # --- ICONS ---
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    # --- BEHAVIOR ---
    sort = yes
    idle_threshold = 120
    sticky_history = yes
    history_length = 50
    always_run_script = true
    ignore_dbusclose = false

    # --- MOUSE ---
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    # --- WAYLAND ---
    layer = overlay
    force_xwayland = false

[urgency_low]
    background = "#080808"
    foreground = "#888888"
    frame_color = "#1a1a1a"
    highlight = "#555555"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#080808"
    foreground = "#cccccc"
    frame_color = "#1a1a1a"
    highlight = "#cccccc"
    timeout = 6
    default_icon = dialog-information
    override_pause_level = 30

[urgency_critical]
    background = "#080808"
    foreground = "#cc4444"
    frame_color = "#cc4444"
    highlight = "#cc4444"
    timeout = 0
    default_icon = dialog-warning
    override_pause_level = 60
