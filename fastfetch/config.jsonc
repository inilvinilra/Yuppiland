{
    // ╔══════════════════════════════════════════════════════════════╗
    // ║  VOID — Fastfetch Configuration                              ║
    // ║  ~/.config/fastfetch/config.jsonc                             ║
    // ╚══════════════════════════════════════════════════════════════╝

    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "color": {
            "1": "bright_black",
            "2": "white"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "bright_black",
            "title": "white",
            "output": "white"
        },
        "key": {
            "width": 7
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "────────────────────"
        },
        {
            "type": "os",
            "key": " os",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": " krn",
            "format": "{release}"
        },
        {
            "type": "wm",
            "key": " wm"
        },
        {
            "type": "shell",
            "key": " sh"
        },
        {
            "type": "terminal",
            "key": " term"
        },
        {
            "type": "packages",
            "key": " pkg",
            "format": "{all}"
        },
        {
            "type": "uptime",
            "key": " up",
            "format": "{days}d {hours}h {minutes}m"
        },
        {
            "type": "separator",
            "string": "────────────────────"
        },
        {
            "type": "cpu",
            "key": " cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": " gpu",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": " mem",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": " dsk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": " bat",
            "format": "{capacity} [{status}]"
        },
        {
            "type": "separator",
            "string": "────────────────────"
        },
        {
            "type": "display",
            "key": " dsp",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "command",
            "key": " app",
            "text": "if command -v thunar >/dev/null 2>&1; then echo thunar; elif command -v dolphin >/dev/null 2>&1; then echo dolphin; else echo files; fi"
        },
        {
            "type": "command",
            "key": " web",
            "text": "if command -v brave >/dev/null 2>&1; then echo brave; elif command -v zen-browser >/dev/null 2>&1; then echo zen; elif command -v firefox >/dev/null 2>&1; then echo firefox; elif command -v chromium >/dev/null 2>&1; then echo chromium; else echo browser; fi"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 1,
            "symbol": "circle"
        }
    ]
}
